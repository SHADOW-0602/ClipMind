# ClipMind environment
# ---------------------------------------------------------------------------
# ClipMind always runs against a live provider. The default is Groq's free
# tier: OpenAI-compatible chat plus Whisper transcription with one API key.
# Create a key at https://console.groq.com/keys and set MODEL_API_KEY.
# Never commit a real .env file.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Provider ----------------------------------------------------------------
# Presets: groq (free), gemini (free), openrouter (free models), ollama,
# lmstudio, mistral, cerebras, deepseek, together, openai, xai, fireworks,
# perplexity, custom, meta.
# A preset fills the LLM_* and ASR_* settings below. Any value you set
# explicitly still wins, so you can keep a preset and override one model.
PROVIDER=groq
MODEL_API_KEY=
# LLM_API_KEY=
# META_API_KEY=

# --- OpenAI-compatible provider ---------------------------------------------
# The preset supplies these. Uncomment only to override them.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_ASR_MODEL=whisper-large-v3-turbo
# LLM_TIMEOUT_S=120
# LLM_MAX_RETRIES=4
# LLM_JSON_MODE=auto
# LLM_MAX_TOKENS_FIELD=max_tokens
# LLM_TEMPERATURE=
# LLM_VISION=false

# --- Meta Model API (optional native provider) -------------------------------
# Set PROVIDER=meta to use the Responses API. Auth: Bearer META_API_KEY or
# MODEL_API_KEY.
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# META_ASR_MODEL=muse-voice-transcribe-1.0
# META_TIMEOUT_S=120
# META_MAX_RETRIES=4
# META_REASONING_EFFORT=low

# --- Speech-to-text ----------------------------------------------------------
# The preset chooses the ASR route. Uncomment to force one:
#   auto              Meta ASR for PROVIDER=meta, local Whisper for custom,
#                     OpenAI-compatible ASR for the other hosted presets
#   openai_compatible /audio/transcriptions on LLM_BASE_URL
#   meta              Meta Voice Transcribe
#   whisper           local faster-whisper (pip install -e "./backend[whisper]")
# ASR_PROVIDER=auto
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
FORCE_WHISPER=false

# --- Cost guard --------------------------------------------------------------
# Free-tier presets report $0. If you use a paid tier, set list prices below
# so MAX_BUDGET_USD can protect you.
MAX_BUDGET_USD=100
HACKATHON_CREDITS_USD=150
# LLM_INPUT_PRICE_PER_M=0
# LLM_CACHED_INPUT_PRICE_PER_M=0
# LLM_OUTPUT_PRICE_PER_M=0
# LLM_ASR_USD_PER_HOUR=0
# META_INPUT_PRICE_PER_M=1.25
# META_CACHED_INPUT_PRICE_PER_M=0.15
# META_OUTPUT_PRICE_PER_M=4.25
# META_ASR_USD_PER_HOUR=0.18

# --- Storage and scheduling --------------------------------------------------
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/clipmind.db
MAX_UPLOAD_MB=500
MAX_DURATION_S=7200
MIN_CLIP_S=15
MAX_CLIP_S=60
JOB_CONCURRENCY=1
AUTO_RESUME_JOBS=true
RATE_LIMIT_PER_MINUTE=60

# --- API / frontend ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CLIPMIND_API_URL=http://localhost:8000
CLIPMIND_WEB_URL=http://localhost:3000
