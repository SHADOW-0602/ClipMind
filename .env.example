# ClipMind environment
# ---------------------------------------------------------------------------
# Safe default: the complete pipeline runs offline with deterministic mock AI.
# Switch to the Meta Model API with MOCK_MODE=false and PROVIDER=meta, then set
# MODEL_API_KEY. Never commit a real .env file.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
MOCK_MODE=true
PROVIDER=mock

# --- Meta Model API (https://dev.meta.ai/docs) -------------------------------
# Auth: Authorization: Bearer MODEL_API_KEY
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_ASR_MODEL=muse-voice-transcribe-1.0
USE_META_ASR=true
META_TIMEOUT_S=120
META_MAX_RETRIES=4
META_REASONING_EFFORT=low

# --- Cost guard --------------------------------------------------------------
# The hackathon starts with $150 in credits. The pipeline refuses to start a
# model call that would take spend over MAX_BUDGET_USD.
MAX_BUDGET_USD=100
HACKATHON_CREDITS_USD=150
META_INPUT_PRICE_PER_M=1.25
META_CACHED_INPUT_PRICE_PER_M=0.15
META_OUTPUT_PRICE_PER_M=4.25

# --- Storage and scheduling --------------------------------------------------
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/clipmind.db
MAX_UPLOAD_MB=500
MAX_DURATION_S=7200
MIN_CLIP_S=15
MAX_CLIP_S=60
JOB_CONCURRENCY=1
AUTO_RESUME_JOBS=true
RATE_LIMIT_PER_MINUTE=60

# --- Speech-to-text ----------------------------------------------------------
# Muse Voice Transcribe is used when a key is present and USE_META_ASR=true.
# Optional local fallback: pip install -e "./backend[whisper]"
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
FORCE_WHISPER=false

# --- API / frontend ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CLIPMIND_API_URL=http://localhost:8000
CLIPMIND_WEB_URL=http://localhost:3000
